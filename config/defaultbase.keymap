 {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp ESC                  &kp ESC  &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp A  &kp F                    &kp F    &kp J  &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C  &kp V  &kp B                    &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH
                            &kp G    &kp T    &kp T  &kp H
            >;
        };
    };
};
